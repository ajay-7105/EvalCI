{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalCI result (schema version 2)",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "decision",
    "exit_code",
    "settings",
    "scope",
    "cost",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "ERROR"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "settings": {
      "type": "object",
      "required": [
        "runs_per_case",
        "min_drop_threshold",
        "max_spread_before_unreliable"
      ],
      "properties": {
        "runs_per_case": {
          "type": "integer",
          "minimum": 1
        },
        "min_drop_threshold": {
          "type": "number"
        },
        "max_spread_before_unreliable": {
          "type": "number"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "mode",
        "suites"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "scoped",
            "full",
            "baseline-dir"
          ]
        },
        "base": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          }
        },
        "head": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          }
        },
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "suite",
              "file",
              "action",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "suite": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "run",
                  "skip",
                  "removed"
                ]
              },
              "reason": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "currency",
        "input_tokens",
        "output_tokens",
        "estimated_cost",
        "partial",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "model",
              "calls",
              "input_tokens",
              "output_tokens",
              "unknown_calls",
              "cost"
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "unknown_calls": {
                "type": "integer",
                "minimum": 0
              },
              "cost": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "suite",
          "case",
          "critical",
          "status",
          "baseline",
          "candidate"
        ],
        "additionalProperties": false,
        "properties": {
          "suite": {
            "type": "string"
          },
          "case": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "REGRESSED",
              "UNRELIABLE",
              "ERROR",
              "NEW"
            ]
          },
          "drop": {
            "type": [
              "number",
              "null"
            ]
          },
          "baseline": {
            "$ref": "#/$defs/side"
          },
          "candidate": {
            "$ref": "#/$defs/side"
          }
        }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": [
        "runs",
        "failed_runs",
        "scores"
      ],
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "failed_runs": {
          "type": "integer",
          "minimum": 0
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "average": {
          "type": [
            "number",
            "null"
          ]
        },
        "spread": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
